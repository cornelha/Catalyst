{
  "name": "catalyst",
  "version": "0.3.0",
  "description": "Ticket orchestration pattern for coding agents — fan out, reduce, verify, synthesize. Decomposes tickets into parallel investigation tasks, consolidates findings, skeptically re-verifies each against real code, and only then produces an implementation plan.",
  "author": {
    "name": "cornelha"
  },
  "repository": "https://github.com/cornelha/catalyst",
  "license": "MIT",
  "keywords": ["orchestration", "tickets", "verification", "multi-agent", "code-review", "bug-fix"],
  "commands": [
    "./.claude/commands/catalyst.md",
    "./.claude/commands/catalyst-install.md",
    "./.claude/commands/add-skill.md",
    "./.claude/commands/add-template.md",
    "./.claude/commands/build-catalyst.md",
    "./.claude/commands/catalyst-testcases.md",
    "./.claude/commands/learn.md"
  ],
  "agents": [
    "./agent-subagents/claude-code/catalyst-orchestrator.md",
    "./agent-subagents/claude-code/catalyst-fan-out-analyst.md",
    "./agent-subagents/claude-code/catalyst-verifier.md",
    "./agent-subagents/claude-code/catalyst-synthesizer.md",
    "./agent-subagents/claude-code/catalyst-code-reviewer.md"
  ]
}
